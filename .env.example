# ═══════════════════════════════════════════════════════════
#  متغيّرات البيئة لموقع ZONE X — انسخ هذا الملف لاسم .env
#  على السيرفر، واملأ القيم الحقيقية.
#  محلياً (على لابتوبك) ما بدك هذا الملف — الكود يشتغل تلقائياً.
# ═══════════════════════════════════════════════════════════

# ── أساسي (إلزامي على السيرفر) ──
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=ضع-هنا-مفتاح-عشوائي-طويل-50-حرف
DJANGO_ALLOWED_HOSTS=zonex.com,www.zonex.com
DJANGO_CSRF_ORIGINS=https://zonex.com,https://www.zonex.com

# ── سر كود التفعيل (لازم نفسه في التطبيق المحلي) ──
ZONEX_LICENSE_SECRET=ZX2026_pK9fL3mQ7rT2vN8wB5xH4dJ0cG6sZ_aE1nY_LICENCE

# ── قاعدة البيانات PostgreSQL (اختياري — إذا فاضي يستعمل SQLite) ──
# DB_NAME=zonex
# DB_USER=zonex_user
# DB_PASSWORD=كلمة-سر-قوية
# DB_HOST=localhost
# DB_PORT=5432

# ── HTTPS ──
